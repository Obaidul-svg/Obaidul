rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Storefront theme and settings: readable by all, writable by authenticated users
    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Products catalog: publicly readable, writable by authenticated staff
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Orders: readable by auth user or staff; orders can be created upon checkout
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Discounts: readable by all (to validate promo codes), writable by authenticated staff
    match /discounts/{discountId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
